% Generated by validation/gmat/make_scripts.py. Do not edit by hand.

Create Spacecraft Sat;
GMAT Sat.DateFormat = TTGregorian;
GMAT Sat.Epoch = '01 Jan 2000 12:00:00.000';
GMAT Sat.CoordinateSystem = EarthMJ2000Eq;
GMAT Sat.DisplayStateType = Cartesian;
GMAT Sat.X = -713.293097078990172;
GMAT Sat.Y = 6450.675387714022690;
GMAT Sat.Z = 3117.691453623977850;
GMAT Sat.VX = -7.349101032588732;
GMAT Sat.VY = -1.755540680762952;
GMAT Sat.VZ = 1.950917887713549;
GMAT Sat.DryMass = 100.0;
GMAT Sat.Cd = 2.2;
GMAT Sat.DragArea = 1.0;
GMAT Sat.SRPArea = 0;

Create ForceModel FM;
GMAT FM.CentralBody = Earth;
GMAT FM.PrimaryBodies = {Earth};
GMAT FM.GravityField.Earth.PotentialFile = 'EGM96.cof';
GMAT FM.GravityField.Earth.Degree = 0;
GMAT FM.GravityField.Earth.Order = 0;
GMAT FM.Drag.AtmosphereModel = None;
GMAT FM.SRP = Off;
GMAT FM.RelativisticCorrection = Off;

Create Propagator Prop;
GMAT Prop.FM = FM;
GMAT Prop.Type = RungeKutta89;
GMAT Prop.InitialStepSize = 60;
GMAT Prop.Accuracy = 1e-13;
GMAT Prop.MinStep = 0;
GMAT Prop.MaxStep = 600;

Create ReportFile Report;
GMAT Report.Filename = 'D:/urania/tests/fixtures/gmat/twobody.txt';
GMAT Report.Precision = 16;
GMAT Report.WriteHeaders = true;
GMAT Report.LeftJustify = On;
GMAT Report.ZeroFill = Off;

Create Variable k tStop;

BeginMissionSequence;
Toggle Report Off;
Report Report Sat.ElapsedSecs Sat.EarthMJ2000Eq.X Sat.EarthMJ2000Eq.Y Sat.EarthMJ2000Eq.Z Sat.EarthMJ2000Eq.VX Sat.EarthMJ2000Eq.VY Sat.EarthMJ2000Eq.VZ;
For k = 1:1:24
   tStop = k * 3600;
   Propagate Prop(Sat) {Sat.ElapsedSecs = tStop};
   Report Report Sat.ElapsedSecs Sat.EarthMJ2000Eq.X Sat.EarthMJ2000Eq.Y Sat.EarthMJ2000Eq.Z Sat.EarthMJ2000Eq.VX Sat.EarthMJ2000Eq.VY Sat.EarthMJ2000Eq.VZ;
EndFor;
